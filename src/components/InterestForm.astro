---
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { form: copy } = t(Astro.props.lang);
---

<section class="interest">
  <h2>{copy.heading}</h2>
  <div class="panel">
    <p class="coming-soon">{copy.comingSoon}</p>
    <form class="interest-form" novalidate>
      <label id="name-label" for="name-input">
        {copy.name}
      </label>
      <input
        id="name-input"
        name="name"
        type="text"
        required
        disabled
        aria-labelledby="name-label"
        placeholder="Your full name"
        autocomplete="name"
      />

      <label id="email-label" for="email-input">
        {copy.email}
      </label>
      <input
        id="email-input"
        name="email"
        type="email"
        required
        disabled
        aria-labelledby="email-label"
        placeholder="your@email.com"
        autocomplete="email"
      />

      <label id="message-label" for="message-input">
        {copy.message}
      </label>
      <textarea
        id="message-input"
        name="message"
        required
        disabled
        aria-labelledby="message-label"
        placeholder="Tell us about your project..."
        rows={3}
        autocomplete="off"
      ></textarea>

      <button type="submit" disabled aria-busy="false">
        {copy.send}
      </button>
    </form>
  </div>
</section>
