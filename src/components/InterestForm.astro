---
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { form: copy } = t(Astro.props.lang);
const enabled = Boolean(
  import.meta.env.PUBLIC_LEAD_BASE_URL && import.meta.env.PUBLIC_LEAD_SITE_KEY
);
---

<section class="interest">
  <h2>{copy.heading}</h2>
  <div class="panel">
    {!enabled && (
      <p id="coming-soon" class="coming-soon">
        {copy.comingSoon}
      </p>
    )}
    <form
      class="interest-form"
      novalidate={!enabled}
      data-sent={copy.sent}
      data-rate-limited={copy.rateLimited}
      data-invalid={copy.invalid}
      data-error={copy.error}
    >
      <fieldset
        disabled={!enabled}
        aria-describedby={!enabled ? 'coming-soon' : undefined}
      >
        <legend class="visually-hidden">{copy.legend}</legend>

        <label for="name-input">{copy.name}</label>
        <input
          id="name-input"
          name="name"
          type="text"
          required
          autocomplete="name"
        />

        <label for="email-input">{copy.email}</label>
        <input
          id="email-input"
          name="email"
          type="email"
          required
          autocomplete="email"
        />

        <label for="message-input">{copy.message}</label>
        <textarea
          id="message-input"
          name="message"
          required
          rows={3}
        ></textarea>

        <button type="submit">{copy.send}</button>
      </fieldset>
      <p class="status" role="status"></p>
    </form>
  </div>
</section>

<script>
  const baseUrl = import.meta.env.PUBLIC_LEAD_BASE_URL;
  const apiKey = import.meta.env.PUBLIC_LEAD_SITE_KEY;
  const form = document.querySelector<HTMLFormElement>('.interest-form');
  if (baseUrl && apiKey && form) {
    const status = form.querySelector<HTMLElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('button')!;
    const messages: Record<number, string | undefined> = {
      429: form.dataset.rateLimited,
      422: form.dataset.invalid
    };
    const sdk = import('@mrcaumartin/lead-sdk');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      button.disabled = true;
      status.textContent = '';
      try {
        const { init } = await sdk;
        await init({ baseUrl, apiKey }).submitForm({
          name: String(data.get('name')),
          email: String(data.get('email')),
          message: String(data.get('message'))
        });
        form.reset();
        status.textContent = form.dataset.sent!;
      } catch (error) {
        const code = (error as { status?: number }).status ?? 0;
        status.textContent = messages[code] ?? form.dataset.error!;
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .panel {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  .coming-soon {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }
  fieldset {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    border: none;
    min-inline-size: 0;
  }
  input,
  textarea {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    padding: var(--space-2);
    font: inherit;
  }
  input:user-invalid,
  textarea:user-invalid {
    border-color: var(--color-danger);
  }
  .status {
    margin: var(--space-2) 0 0;
    font-size: var(--font-size-sm);
  }
  .status:empty {
    display: none;
  }
  button {
    align-self: flex-start;
    margin-top: var(--space-2);
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-sm);
    border: none;
    background: var(--color-accent);
    color: var(--color-bg);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  fieldset:disabled input,
  fieldset:disabled textarea,
  fieldset:disabled button {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
