---
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { hero: copy } = t(Astro.props.lang);
---

<section class="hero">
  <h1>Alex Caumartin</h1>
  <hr class="rule" aria-hidden="true" />
  <p class="tagline">{copy.tagline}</p>
</section>

<style>
  .hero {
    padding-block: calc(var(--space-8) * 1.5) var(--space-6);
  }
  h1 {
    margin: 0;
    font-size: var(--font-size-display);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .rule {
    inline-size: 100%;
    max-inline-size: 220px;
    block-size: 1px;
    margin-block: var(--space-5);
    margin-inline: 0;
    border: none;
    background: var(--color-accent);
    transform-origin: left;
    animation: rule-draw 0.6s ease-out;
  }
  .tagline {
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
    max-inline-size: 60ch;
  }
  @keyframes rule-draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rule {
      animation: none;
    }
  }
</style>
