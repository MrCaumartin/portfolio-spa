---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Services from './Services.astro';
import Process from './Process.astro';
import InterestForm from './InterestForm.astro';
import Header from './Header.astro';
import LangBanner from './LangBanner.astro';
import Footer from './Footer.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { meta } = t(lang);
---

<BaseLayout title={meta.title} description={meta.description} lang={lang}>
  {lang === 'en' && <LangBanner />}
  <Header lang={lang} />
  <main id="content" tabindex="-1">
    <Hero lang={lang} />
    <About lang={lang} />
    <Services lang={lang} />
    <Process lang={lang} />
    <InterestForm lang={lang} />
  </main>
  <Footer />
</BaseLayout>
