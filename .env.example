# GA4 measurement ID (e.g. G-XXXXXXXXXX). If unset, no analytics snippet renders.
PUBLIC_GA_MEASUREMENT_ID=

# Lead SDK. Both must be set to enable tracking and the contact form; otherwise nothing loads
# and the form stays disabled. PUBLIC_LEAD_BASE_URL is the gateway origin (e.g. https://gateway.example.com);
# PUBLIC_LEAD_SITE_KEY is the portfolio Application's public site key, from auth's platform console;
# the Application must hold the leads:submit permission.
PUBLIC_LEAD_BASE_URL=
PUBLIC_LEAD_SITE_KEY=
